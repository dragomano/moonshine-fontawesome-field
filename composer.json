{
  "name": "bugo/moonshine-fontawesome-field",
  "description": "Font Awesome icons selection field for MoonShine",
  "keywords": [
    "moonshine",
    "fontawesome"
  ],
  "type": "library",
  "homepage": "https://github.com/dragomano/moonshine-fontawesome-field",
  "license": "MIT",
  "authors": [
    {
      "name": "Bugo",
      "email": "bugo@dragomano.ru"
    }
  ],
  "require": {
    "php": "^8.2",
    "bugo/blade-fontawesome": "^3.3"
  },
  "require-dev": {
    "moonshine/moonshine": "^4.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.8|^4.6",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "rector/rector": "^2.5"
  },
  "autoload": {
    "psr-4": {
      "Bugo\\MoonShine\\FontAwesome\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MoonShine\\": "vendor/moonshine/moonshine/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "test": "vendor/bin/pest --colors=always",
    "test-coverage": "vendor/bin/pest --colors=always --coverage --min=100",
    "test-coverage-clover": "vendor/bin/pest --colors=always --min=100 --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --colors=always --min=100 --coverage-html coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bugo\\MoonShine\\FontAwesome\\Providers\\IconServiceProvider"
      ]
    }
  },
  "conflict": {
    "moonshine/moonshine": "<4.0"
  },
  "minimum-stability": "dev",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
